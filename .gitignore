# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# turborepo
.turbo/

# expo / react native
.expo/
.expo-shared/
dist/
web-build/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
expo-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# Internal security docs
SECURITY-FINDINGS.md
.claude/worktrees/

# Internal project docs — everything at repo root except README.md is
# working/planning material, not meant to be public. Files stay on disk,
# just not tracked/pushed. See CLAUDE.md's standard doc table for the
# intended file set; this pattern also covers any future root-level .md.
/*.md
!/README.md
.impeccable/
package-lock.json
node_modules/.package-lock.json
