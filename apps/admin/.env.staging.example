# Reference only — see apps/web/.env.production.example for why this isn't
# a file Next.js loads automatically. This is the NEW staging admin Vercel
# project (deploys from `staging`, no custom domain — plain *.vercel.app
# URL). Paste these into that project's Settings → Environment Variables →
# Production (scoped per-project, same reasoning as the web staging file).
#
# Same Supabase project as production for now — same flag as web's staging
# file: revisit if a separate staging database gets set up later.

# Fill in once Vercel assigns the staging web project's URL.
NEXT_PUBLIC_WEB_URL=https://<staging-web-project>.vercel.app

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=

CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
