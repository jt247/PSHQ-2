# Main site (apps/web) — separate deployment. Used for sign-in/sign-out
# redirects and cross-app links, since this app has no auth pages of its own.
NEXT_PUBLIC_WEB_URL=https://your-domain.com

# Supabase — same project as apps/web
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — admin broadcast notifications and team invites
RESEND_API_KEY=

# Cloudflare R2 — content cover image uploads
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
