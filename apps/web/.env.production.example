# Reference only — Next.js doesn't auto-load a file named .env.production.example
# (only .env, .env.local, .env.production, .env.development are read
# automatically, keyed off NODE_ENV, and Vercel builds always run with
# NODE_ENV=production regardless of which Vercel Environment they're deployed
# to). Real separation between production and staging happens because they
# are two separate Vercel projects, each with its own Environment Variables
# configured in its own dashboard — this file exists so those values are
# written down somewhere reviewable, not typed once and forgotten.
#
# This is the PRODUCTION project (existing pshq-2 Vercel project, deploys
# from `main`, serves productslicehq.com). Paste these into that project's
# Settings → Environment Variables → Production.

NEXT_PUBLIC_SITE_URL=https://www.productslicehq.com
NEXT_PUBLIC_ADMIN_URL=https://admin.productslicehq.com

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

OPENAI_API_KEY=
NVIDIA_API_KEY=

CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

SENTRY_DSN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
