# Reference only — see .env.production.example for why this isn't a file
# Next.js loads automatically. This is the NEW staging Vercel project (to be
# created, deploys from `staging`, no custom domain — plain *.vercel.app URL).
# Paste these into that project's Settings → Environment Variables →
# Production (Vercel's "Production" environment is scoped per-project, so
# the staging project's own "Production" environment is what actually runs
# when it deploys the `staging` branch).
#
# Same Supabase project as production for now (no separate staging database
# has been set up) — flag if that changes, since RLS-protected real user
# data would then be reachable from a non-production deployment.

# Fill in once Vercel assigns the staging project's URL.
NEXT_PUBLIC_SITE_URL=https://<staging-web-project>.vercel.app
NEXT_PUBLIC_ADMIN_URL=https://<staging-admin-project>.vercel.app

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

OPENAI_API_KEY=
NVIDIA_API_KEY=

CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

SENTRY_DSN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
