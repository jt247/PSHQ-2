# App
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Admin app (apps/admin) — separate deployment. Used for the dashboard's
# "Tactical Ops" link and post-login/onboarding redirects for admin users.
NEXT_PUBLIC_ADMIN_URL=https://admin.your-domain.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# AI summary generation — OpenAI is used when this is set (preferred, stable).
# Falls back to NVIDIA Build below when this is empty.
OPENAI_API_KEY=

# NVIDIA Build — fallback for AI summary generation when OPENAI_API_KEY isn't set.
NVIDIA_API_KEY=

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# Sentry
SENTRY_DSN=

# Upstash Redis (rate limiting) — create a database at https://console.upstash.com
# Without these set, rate limiting falls back to best-effort in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
