# Same Supabase project as apps/web and apps/admin.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Use www, not the apex domain — the apex 308-redirects to www, and that
# cross-origin hop strips the Authorization header on every Bearer-authed
# mobile request (confirmed live: AI summaries, downloads, comments, all
# of it silently 401s after the redirect). Hitting www directly avoids
# the redirect entirely.
EXPO_PUBLIC_API_BASE_URL=https://www.productslicehq.com
